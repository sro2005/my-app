# Variables de ejemplo para la vista previa ElectroVibeHome v2.
# Nunca publiques credenciales reales ni las incluyas en Git.
NODE_ENV=production
MONGODB_URI=
ALLOWED_ORIGINS=https://electrovibehome-v2-preview.onrender.com
FRONTEND_URL=https://electrovibehome-v2-preview.onrender.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Correo transaccional para producción: usa la API HTTPS de Brevo, no Gmail SMTP.
# El remitente debe registrarse y verificarse en Brevo. BREVO_SENDER_EMAIL puede omitirse
# para reutilizar NO_REPLY_EMAIL_ADDRESS como remitente.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ElectroVibeHome

# Gmail SMTP se conserva para desarrollo local; Render Free bloquea el puerto 587.
GENERAL_EMAIL_ADDRESS=
GENERAL_EMAIL_PASSWORD=
NO_REPLY_EMAIL_ADDRESS=
NO_REPLY_EMAIL_PASSWORD=
JWT_SECRET=
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
# Mantén credenciales Wompi de prueba y webhook de Sandbox mientras esta versión siga siendo una demo.
