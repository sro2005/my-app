# Configuración de referencia del backend de ElectroVibeHome (rama electrovibehome-stable).
# Valores de ejemplo SIN credenciales. Revisa los dominios y el destino de MongoDB antes de usarlos.
NODE_ENV=production
# El backend admite MONGO_URI (o MONGODB_URI) para su conexión a MongoDB.
MONGO_URI=
ALLOWED_ORIGINS=https://electrovibehome.onrender.com
FRONTEND_URL=https://electrovibehome.onrender.com
# La Guía ElectroVibe usa modo local; no requiere clave ni modelo de IA externo.

# Brevo: envío de correos transaccionales por API HTTPS.
# Registra y verifica el remitente en Brevo antes de habilitar el servicio.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ElectroVibeHome

# SMTP solo como alternativa de desarrollo local, si el código y el entorno lo permiten.
GENERAL_EMAIL_ADDRESS=
GENERAL_EMAIL_PASSWORD=
NO_REPLY_EMAIL_ADDRESS=
NO_REPLY_EMAIL_PASSWORD=
JWT_SECRET=

# Pagos en pausa: no configurar credenciales reales ni habilitar cobros.
# Si se reanuda Wompi en el futuro, usar exclusivamente credenciales Sandbox
# y validar webhooks, estados e inventario antes de cualquier despliegue.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
